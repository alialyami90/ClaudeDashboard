                    </Grid>
                    <TextBlock Text="Addresses are kept encrypted for your Windows account and shown shortened. Calendars update every 15 minutes while the widget is shown (30 in Quiet mode); a tap on the card updates them now." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,12,0,16"/>
