                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="HomeChoices" Margin="0,0,12,0"/></ScrollViewer>
                  </Grid>
                </Grid>
              </TabItem>
                            <TabItem Header="Spotify">
