                <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="NetworkChoice" Content="Network speed" Margin="0,0,12,8"/><ComboBox x:Name="NetworkStyle" Grid.Column="1" Width="190" Margin="0,0,0,8" AutomationProperties.Name="Network speed graph" ToolTip="How the card draws it: Auto picks rings and gauges on medium cards and history lines on large ones"/></Grid>
