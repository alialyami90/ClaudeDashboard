                      <StackPanel Grid.Column="2"><TextBlock Text="iCal address" Style="{StaticResource Small}" Margin="0,0,0,6"/><TextBox x:Name="CalendarFeedUrl" MaxLength="2048" FontSize="16" AutomationProperties.Name="Calendar iCal address"/></StackPanel>
