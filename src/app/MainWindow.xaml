<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Widget Screen" Width="1536" Height="640" MinWidth="960" MinHeight="400"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False">
  <Window.Resources>
<SolidColorBrush x:Key="Page" Color="#0C0E13"/>
<SolidColorBrush x:Key="Surface" Color="#161A22"/>
<SolidColorBrush x:Key="Raised" Color="#252B36"/>
<SolidColorBrush x:Key="Input" Color="#10141C"/>
<SolidColorBrush x:Key="Track" Color="#353D49"/>
<SolidColorBrush x:Key="Selected" Color="#394252"/>
<SolidColorBrush x:Key="ClockSurface" Color="#1C2420"/>
<SolidColorBrush x:Key="ClockBorder" Color="#344235"/>
    <CornerRadius x:Key="CardRadius">20</CornerRadius>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="18"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabChrome" Background="Transparent" CornerRadius="10" Padding="16,14" Margin="0,0,4,8" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Raised}"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,12,0,0"/></Grid>
    </ControlTemplate></Setter.Value></Setter></Style>

    <SolidColorBrush x:Key="Accent" Color="#BAF28B"/>
    <SolidColorBrush x:Key="Muted" Color="#A0AABB"/>
    <SolidColorBrush x:Key="Text" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="Warning" Color="#F5C47D"/>
    <SolidColorBrush x:Key="ClockMuted" Color="#A8BAAA"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#343C49"/>
    <sys:Double x:Key="SmallSize">15</sys:Double>
    <sys:Double x:Key="BodySize">18</sys:Double>
    <sys:Double x:Key="TitleSize">24</sys:Double>
    <sys:Double x:Key="HeaderClockSize">52</sys:Double>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource SmallSize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <!-- Smallest text on the dashboard: card status flags, keyboard hints and credits. 13 keeps it readable at arm's length. -->
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Raised}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <Grid>
              <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.13"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="#11170E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <!-- Quick Launch keycaps (docs/design/sticker-sheet.md, phase 2): the cap sits on a 4-unit darker skirt and drops 2 units while pressed; an LED dot in the widget's ink lights for a button that's on (Tag = True). -->
    <Style x:Key="Keycap" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Skirt" Background="{DynamicResource Input}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="12" Margin="0,4,0,0"/>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" Margin="0,0,0,4">
              <Grid>
                <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                <Ellipse x:Name="Led" Width="8" Height="8" Fill="{DynamicResource InkOfShortcuts}" Stroke="{DynamicResource Page}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" IsHitTestVisible="False"/>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.13"/><Setter TargetName="Chrome" Property="Margin" Value="0,2,0,2"/></Trigger>
            <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value><Setter TargetName="Led" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/><Setter TargetName="Skirt" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <!-- Soundboard sampler pads (docs/design/sticker-sheet.md, phase 5): a rubber pad edged in the card's ink on a solid
         lift. It lights in the ink, with dark text, while pressed and for 150 ms after a tap (Tag = true). -->
    <Style x:Key="Pad" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Lift" Background="{DynamicResource Page}" CornerRadius="14" Margin="0,3,0,0"/>
            <Border x:Name="Face" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource InkOfSoundboard}" BorderThickness="2" CornerRadius="14" Margin="0,0,0,3">
              <Grid>
                <Border x:Name="Lit" Background="{DynamicResource InkOfSoundboard}" CornerRadius="12" Opacity="0.1" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Lit" Property="Opacity" Value="0.2"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Lit" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource InkText}"/><Setter TargetName="Face" Property="Margin" Value="0,2,0,1"/></Trigger>
            <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value><Setter TargetName="Lit" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource InkText}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.4"/><Setter TargetName="Lift" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <!-- The mixer's channel strips (docs/design/sticker-sheet.md, phase 2): the same slider standing up, filling from the bottom, with the 48 × 48 thumb. -->
    <Style x:Key="VerticalSlider" TargetType="Slider">
      <Setter Property="Orientation" Value="Vertical"/>
      <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
      <Setter Property="MinWidth" Value="48"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Border x:Name="SliderChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="0,2"><Track x:Name="PART_Track" HorizontalAlignment="Center">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Width="6" CornerRadius="3" Background="{DynamicResource Accent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="48" Height="48"><Thumb.Template><ControlTemplate><Grid Background="Transparent"><Border Width="30" Height="30" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Surface}" BorderThickness="3" CornerRadius="15"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Width="6" CornerRadius="3" Background="{DynamicResource Track}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SliderChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderChrome" Property="Opacity" Value="0.3"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>    <!-- Spotify's crate tabs (docs/design/sticker-sheet.md, phase 2): dividers with rounded tops; the chosen one is filled with the widget's ink over an ink line. -->
    <Style x:Key="CrateTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12,12,0,0" Padding="{TemplateBinding Padding}">
            <Grid>
              <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="8,8,0,0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.13"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>    <Style TargetType="Slider">
      <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
      <Setter Property="MinHeight" Value="48"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Border x:Name="SliderChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="2,0"><Track x:Name="PART_Track" VerticalAlignment="Center">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="6" CornerRadius="3" Background="{DynamicResource Accent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="48" Height="48"><Thumb.Template><ControlTemplate><Grid Background="Transparent"><Border Width="30" Height="30" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Surface}" BorderThickness="3" CornerRadius="15"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="6" CornerRadius="3" Background="{DynamicResource Track}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SliderChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderChrome" Property="Opacity" Value="0.3"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="48"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="48"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="52"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selected}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selected}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="MinHeight" Value="48"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid x:Name="ComboRoot">
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate><Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="8"><Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="10" Height="6" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="12,8,36,8" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
            <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="312" PanningMode="VerticalOnly" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
          <Border x:Name="ComboFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboRoot" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
          <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb MinHeight="44"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollThumb" Background="#606D81" CornerRadius="5" Margin="24,2,6,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="MinHeight" Value="48"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="CheckFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="4">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="6" BorderBrush="#798598" BorderThickness="1" Background="{DynamicResource Input}">
              <Path x:Name="CheckMark" Data="M 5,11 L 9,15 L 18,6" Stroke="#11170E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckFrame" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckFrame" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="{DynamicResource Track}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="5"/></Style>
  </Window.Resources>

  <!-- The dashboard is designed at the 1920 × 720 scale; DashboardController.Screen.cs gives this grid a logical size shaped like the screen. -->
  <Viewbox Stretch="Uniform">
    <Grid x:Name="Dashboard" Width="1920" Height="720" Background="{DynamicResource Page}">
      <Grid x:Name="DashboardContent" Margin="32,20,32,16">
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <!-- The clock lives in the header so time and date stay visible in every layout, including while editing. -->
          <StackPanel x:Name="HeaderClock" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-8,32,0" AutomationProperties.Name="Local time and date">
            <TextBlock x:Name="ClockTime" Text="00:00" FontSize="{DynamicResource HeaderClockSize}" FontWeight="Light" FontFamily="Segoe UI Light" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
            <TextBlock x:Name="ClockPeriod" Text="AM" FontSize="{DynamicResource BodySize}" Foreground="{DynamicResource ClockMuted}" VerticalAlignment="Bottom" Margin="8,0,0,14"/>
            <Border Width="2" Background="{DynamicResource ControlBorder}" Margin="22,16,22,12"/>
            <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
              <TextBlock x:Name="ClockDay" Text="THURSDAY" Style="{StaticResource Label}" Foreground="{DynamicResource Accent}"/>
              <TextBlock x:Name="ClockDate" Text="October 8" FontSize="{DynamicResource TitleSize}" Margin="0,1,0,0"/>
            </StackPanel>
          </StackPanel>
          <!-- Layout pages: shown when there is more than one. Swiping the dashboard sideways also switches pages. -->
          <StackPanel x:Name="PageSwitcher" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="Layout pages">
            <Button x:Name="PreviousPageButton" Content="&#xE76B;" Style="{StaticResource IconButton}" ToolTip="Previous page" AutomationProperties.Name="Previous page"/>
            <StackPanel VerticalAlignment="Center" Margin="14,0" MinWidth="120" MaxWidth="260">
              <TextBlock x:Name="PageNameText" Text="Main" HorizontalAlignment="Center"/>
              <TextBlock x:Name="PageCountText" Text="1 of 1" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="NextPageButton" Content="&#xE76C;" Style="{StaticResource IconButton}" ToolTip="Next page" AutomationProperties.Name="Next page"/>
            <!-- Shown while a Claude Code session needs you and the Claude card is on another page; a tap shows that page. -->
            <Button x:Name="ClaudePill" Visibility="Collapsed" Margin="20,0,0,0" Padding="10,4,16,4" BorderBrush="{DynamicResource Warning}" BorderThickness="2" ToolTip="A Claude Code session needs you. Tap to show its page." AutomationProperties.Name="Claude needs you. Show the Claude page.">
              <StackPanel Orientation="Horizontal"><Grid x:Name="ClaudePillCar" Width="40" Height="32" VerticalAlignment="Center"/><TextBlock Text="Claude needs you" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource SmallSize}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
            </Button>
          </StackPanel>
          <!-- A one-time hint for what the dashboard doesn't show by itself; Got it puts it away for good. -->
          <StackPanel x:Name="HintRow" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="Tips">
            <TextBlock x:Name="HintText" Text="Swipe sideways to switch pages  ·  Settings → Phone pairs your phone" Style="{StaticResource Small}" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="HintDismiss" Content="Got it" FontSize="{DynamicResource SmallSize}" Padding="12,4" Margin="14,0,0,0" AutomationProperties.Name="Dismiss tips"/>
          </StackPanel>
          <StackPanel x:Name="MainActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="EditLayoutButton" Content="Edit layout" Margin="0,0,10,0" ToolTip="Move and resize widgets directly on the dashboard."/>
            <Button x:Name="QuietButton" Content="Quiet mode" Margin="0,0,10,0" ToolTip="Pause output levels and slow down updates, for example while gaming." AutomationProperties.Name="Quiet mode, off"/>
            <Button x:Name="FullscreenButton" Content="Second screen" Margin="0,0,10,0" ToolTip="Show the dashboard fullscreen on your second display. F11 switches; Escape returns to a window."/>
            <Button x:Name="TrayButton" Content="Hide to tray" Margin="0,0,10,0" ToolTip="Hide Widget Screen from the taskbar. Its icon stays in the notification area; click it to bring the dashboard back."/>
            <Button x:Name="SettingsButton" Margin="0,0,24,0" ToolTip="Settings" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource IconButton}" Background="Transparent" BorderBrush="{DynamicResource Raised}" ToolTip="Close Widget Screen" AutomationProperties.Name="Close Widget Screen"/>
          </StackPanel>
          <Grid x:Name="EditToolbar" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Top">
            <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Edit layout" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Drag to move or resize" Style="{StaticResource Small}" Margin="0,2,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="UndoLayoutButton" Content="Undo" Margin="0,0,8,0" ToolTip="Undo the last layout change (Ctrl+Z)."/>
              <Button x:Name="RedoLayoutButton" Content="Redo" Margin="0,0,8,0" ToolTip="Redo a layout change (Ctrl+Y)."/>
              <Button x:Name="ResetLayoutButton" Content="Reset layout" Margin="0,0,8,0" ToolTip="Return every widget to the default arrangement. You can undo this."/>
              <Button x:Name="ArrangeLayoutButton" Content="Arrange" Margin="0,0,18,0" ToolTip="Line up the shown widgets neatly in their current order, filling the screen without gaps or overlaps. You can undo this." AutomationProperties.Name="Arrange widgets"/>
              <CheckBox x:Name="SnapLayoutChoice" Content="Snap" Margin="0,0,18,0" ToolTip="Snap to an 8 pixel grid and to other widgets' edges, with guide lines while you drag."/>
              <Button x:Name="EditWidgetsButton" Content="Widgets" ToolTip="Show or hide widgets, and add, rename, order or delete pages." AutomationProperties.Name="Widgets and pages"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="CancelLayoutButton" Content="Cancel" Margin="0,0,8,0"/>
              <Button x:Name="SaveLayoutButton" Content="Save layout" Style="{StaticResource AccentButton}"/>
            </StackPanel>
          </Grid>
        </Grid>

        <Grid x:Name="WidgetColumns" Grid.Row="1">
          <!-- Claude Code sessions, plan limits and usage. ClaudeCard builds the Small, Medium or Large design in ClaudeBody (docs/design/claude-watcher.md). -->
          <Border x:Name="ClaudeCard" Style="{StaticResource Card}" AutomationProperties.Name="Claude Code">
            <Grid x:Name="ClaudeBody"/>
          </Border>
        </Grid>

        <DockPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock x:Name="StatusMessage" Text="" Style="{StaticResource Small}" MaxWidth="1380"/><TextBlock x:Name="DisplayStatus" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      </Grid>

      <!-- Edit layout's list, the same as the phone's: a check mark per widget and the layout pages. Tapping outside closes it. -->
      <Grid x:Name="EditPanelLayer" Visibility="Collapsed" Background="Transparent">
        <Border x:Name="EditPanel" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="16" Width="460" Padding="16,12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,92,332,52">
          <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"><StackPanel x:Name="EditPanelContent"/></ScrollViewer>
        </Border>
      </Grid>

      <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#E80C0E13" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border x:Name="SettingsCard" Style="{StaticResource Card}" Width="1440" Height="672" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource ControlBorder}">
          <Border.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="52"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="52"/></Style>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Setter Property="MinHeight" Value="52"/></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="52"/></Style>
          </Border.Resources>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="64"/></Grid.RowDefinitions>
            <DockPanel><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CancelSettings" Content="&#xE8BB;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Cancel settings"/></DockPanel>
<TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="0,12,0,8">
              <TabItem Header="Theme">
              <Grid>
              <Grid.ColumnDefinitions>
              <ColumnDefinition Width="570"/>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel>
              <TextBlock Text="Appearance" FontSize="24" Margin="0,0,0,10"/>
              <TextBlock Text="Changes preview on the dashboard. Save to keep them." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <TextBlock Text="Theme" Style="{StaticResource Small}" Margin="0,10,0,6"/>
              <ComboBox x:Name="ThemeChoice" AutomationProperties.Name="Theme"/>
              <TextBlock Text="Accent color" Style="{StaticResource Small}" Margin="0,10,0,6"/>
              <ComboBox x:Name="AccentChoice" AutomationProperties.Name="Accent color"/>
              <TextBlock Text="Widget colours" Style="{StaticResource Small}" Margin="0,10,0,6"/>
              <ComboBox x:Name="InkModeChoice" AutomationProperties.Name="Widget colours" ToolTip="Each its own: every widget wears its ink (change one in Edit layout). Accent only: every widget wears the accent colour."/>
              <DockPanel Margin="0,14,0,0">
              <TextBlock Text="Widget corners" Style="{StaticResource Small}"/>
              <TextBlock x:Name="CornersLabel" Style="{StaticResource Small}" HorizontalAlignment="Right"/>
              </DockPanel>
              <Slider x:Name="CornersChoice" Minimum="0" Maximum="24" TickFrequency="4" IsSnapToTickEnabled="True" AutomationProperties.Name="Widget corners"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
              <TextBlock Text="Readability" FontSize="24" Margin="0,0,0,10"/>
              <TextBlock Text="Size text for your screen and how far you sit from it." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <DockPanel Margin="0,14,0,0">
              <TextBlock Text="Text size" Style="{StaticResource Small}"/>
              <TextBlock x:Name="ScaleLabel" Style="{StaticResource Small}" HorizontalAlignment="Right"/>
              </DockPanel>
              <Slider x:Name="ScaleChoice" Minimum="90" Maximum="140" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Text size"/>
              <TextBlock Text="Above 115% some cards show less at once; give them more room in Edit layout." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <CheckBox x:Name="ClockChoice" Content="Use a 24-hour clock"/>
              </StackPanel>
              </Grid>
              </TabItem>
              <TabItem Header="Display">
              <StackPanel MaxWidth="780" HorizontalAlignment="Left">
              <TextBlock Text="Display" FontSize="24" Margin="0,0,0,10"/>
              <TextBlock Text="Choose the monitor the dashboard fills in fullscreen." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <TextBlock Text="Secondary display" Style="{StaticResource Small}" Margin="0,10,0,6"/>
              <ComboBox x:Name="MonitorChoice" AutomationProperties.Name="Secondary display"/>
              <CheckBox x:Name="StartFullscreenChoice" Content="Open fullscreen on this display at launch" Margin="0,10,0,0"/>
              <TextBlock Text="If this display is unplugged, another secondary display is used. With none connected, the dashboard opens in a window on your main screen." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,12"/>
              <TextBlock Text="F11 switches between fullscreen and a window. Escape leaves fullscreen." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <CheckBox x:Name="KeepFocusChoice" Content="Keep the focus on the game or app I'm using"/>
              <TextBlock Text="Tapping the dashboard won't take the keyboard away from your main screen. Tapping a text box still does, so you can type. F11 and Escape only work after that." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="38,0,0,16"/>
              </StackPanel>
              </TabItem>
              <TabItem Header="Widgets">
              <Grid>
              <Grid.ColumnDefinitions>
              <ColumnDefinition Width="740"/>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
              <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Layout" FontSize="24" Margin="0,0,0,10"/>
              <TextBlock Text="Arrange widgets right on the dashboard: drag to move, stretch a corner to resize, and show or hide each one. Undo, snapping to other widgets, Arrange and Reset are in the editor." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <Button x:Name="OpenLayoutEditor" Content="Edit layout" HorizontalAlignment="Left" MinWidth="200" Margin="0,0,0,12"/>
              <TextBlock Text="Opening the editor closes Settings without saving other changes here." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              </StackPanel>
              </ScrollViewer>
              </Grid>
              </TabItem>
              <TabItem Header="Phone">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="740"/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Phone remote" FontSize="24" Margin="0,0,0,12"/>
                    <TextBlock Text="Use the Widget Screen app on your Android phone to see this dashboard and control this PC over your home Wi-Fi." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <CheckBox x:Name="RemoteEnabledChoice" Content="Let my phone control this PC"/>
                    <CheckBox x:Name="RemoteTrayChoice" Content="Move to the tray while my phone shows the dashboard" ToolTip="Hides Widget Screen from the taskbar while a paired phone is connected, and brings it back a minute after the phone stops."/>
                    <TextBlock x:Name="RemoteStatus" Text="" TextWrapping="Wrap" Margin="0,8,0,12" FontSize="{DynamicResource BodySize}"/>
                    <WrapPanel><Button x:Name="RemotePairButton" Content="Pair a phone" Style="{StaticResource AccentButton}" MinHeight="52" Margin="0,0,8,8"/><Button x:Name="RemoteForgetButton" Content="Forget all phones" Margin="0,0,8,8"/></WrapPanel>
                    <TextBlock x:Name="RemoteDevicesText" Text="" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <!-- One row per paired phone: name, when it paired and was last seen, and its own Forget button. -->
                    <StackPanel x:Name="RemoteDevices" Margin="0,0,0,12"/>
                    <TextBlock Text="Changes here take effect right away. Only phones on your local network can connect, and only after pairing with a code from this screen. The connection isn't encrypted, so use it on a Wi-Fi you trust." Style="{StaticResource Small}" TextWrapping="Wrap"/>
                  </StackPanel></ScrollViewer>
                  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Pairing" FontSize="24" Margin="0,0,0,12"/>
                    <TextBlock Text="1.  Install Widget Screen on your phone and join the same Wi-Fi as this PC." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="2.  Tap Pair a phone. On the phone, pick this PC (or type the address below) and enter the code." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="PC address" Style="{StaticResource Small}"/>
                    <TextBox x:Name="RemoteAddress" IsReadOnly="True" Margin="0,8,0,12" AutomationProperties.Name="PC address for the phone"/>
                    <TextBlock Text="Pairing code" Style="{StaticResource Small}"/>
                    <TextBlock x:Name="RemoteCode" Text="—" FontSize="54" FontWeight="Light" FontFamily="Segoe UI Light" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Pairing code"/>
                    <TextBlock x:Name="RemoteCodeHint" Text="" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="3.  If Windows asks whether Widget Screen may use private networks, allow it. Otherwise the phone can't reach this PC." Style="{StaticResource Small}" TextWrapping="Wrap"/>
                  </StackPanel></ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem Header="Claude">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="740"/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Your Claude plan" FontSize="24" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ClaudePlanStatus" Text="Not signed in" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="{DynamicResource BodySize}"/>
                    <WrapPanel><Button x:Name="ClaudeSignInButton" Content="Sign in with Claude" Style="{StaticResource AccentButton}" MinHeight="52" Margin="0,0,8,8" AutomationProperties.Name="Sign in with Claude"/><Button x:Name="ClaudeSignOutButton" Content="Sign out" Margin="0,0,8,8" Visibility="Collapsed"/></WrapPanel>
                    <TextBlock Text="Opens Claude's sign-in page in your browser. Widget Screen gets its own sign-in, which can only read your profile and your plan's usage: no chats, no credits. It's kept encrypted on this PC, renews itself, and checks your 5-hour and weekly limits on the interval under Refresh (every 5 minutes unless you change it), whether or not Claude Code is open. Your phone gets only the percentages." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,24"/>
                    <TextBlock Text="Claude Code" FontSize="24" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ClaudeConnectionStatus" Text="Not connected" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="{DynamicResource BodySize}"/>
                    <TextBlock x:Name="ClaudeFolderText" Text="" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel><Button x:Name="ClaudeConnectButton" Content="Connect Claude Code" Style="{StaticResource AccentButton}" MinHeight="52" Margin="0,0,8,8"/><Button x:Name="ClaudeDisconnectButton" Content="Disconnect" Margin="0,0,8,8"/></WrapPanel>
                    <TextBlock x:Name="ClaudeTelemetryText" Text="" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ClaudeManagedText" Text="" Style="{StaticResource Small}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <TextBlock Text="Connect and Disconnect take effect right away; you don't need to save. Claude Code picks up the change in sessions you start afterwards." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <CheckBox x:Name="ClaudeChimeChoice" Content="Chime when a session needs me"/>
                    <TextBlock Text="The card lights up either way. Quiet mode keeps the chime off." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="38,0,0,16"/>
                    <CheckBox x:Name="ClaudeToastChoice" Content="Notify me in Windows when a session needs me" AutomationProperties.Name="Show a Windows notification when a Claude Code session needs me"/>
                    <TextBlock Text="Also when a session gets stuck, or finishes a turn of 10 minutes or more. Click the notification to bring the session forward. Quiet mode keeps it silent, and your paired phone gets the same alerts." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="38,0,0,16"/>
                    <CheckBox x:Name="ClaudeStillChoice" Content="Keep the cars still in Quiet mode" AutomationProperties.Name="Keep the Claude cars still in Quiet mode"/>
                    <TextBlock Text="Off: the cars keep driving, revving and rolling into their garages even in Quiet mode. They stop whenever the card is hidden or the window is minimised." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="38,0,0,16"/>
                    <CheckBox x:Name="ClaudeApiValueChoice" Content="Show what the tokens would cost at API list prices" AutomationProperties.Name="Show the API value of the tokens on the Claude card"/>
                    <TextBlock Text="Your Claude plan doesn't pay these prices; the plan meters show your plan's use. Off: the card shows each thread's replies instead." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="38,0,0,16"/>
                    <CheckBox x:Name="ClaudeHideArchivedChoice" Content="Hide resolved and archived threads" AutomationProperties.Name="Hide resolved and archived Claude threads"/>
                    <TextBlock Text="Resolved: the Claude app says the latest reply completed the job. Archived: you archived it in the Claude app. On: they leave the card and the phone, and each project says how many it hides. Off: they park last, dimmed. A resolved thread that starts working again or needs you shows right away." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="38,0,0,16"/>
                    <CheckBox x:Name="ClaudeHideIdleChoice" Content="Hide idle threads" AutomationProperties.Name="Hide idle Claude threads"/>
                    <TextBlock Text="Open threads that have waited 30 minutes or more. Their tokens still count in their project's totals." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="38,0,0,24"/>
                    <TextBlock Text="Side panel facts" FontSize="24" Margin="0,0,0,12"/>
                    <TextBlock Text="The four facts beside the 5-hour lanes on a large Claude card, for the period it shows. Tool times, failures, API errors, edits, commits and active time come from Claude Code's telemetry." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <ComboBox x:Name="ClaudeFact0Choice" Margin="0,0,0,8" AutomationProperties.Name="First side panel fact"/>
                      <ComboBox x:Name="ClaudeFact1Choice" Grid.Column="2" Margin="0,0,0,8" AutomationProperties.Name="Second side panel fact"/>
                      <ComboBox x:Name="ClaudeFact2Choice" Grid.Row="1" AutomationProperties.Name="Third side panel fact"/>
                      <ComboBox x:Name="ClaudeFact3Choice" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="Fourth side panel fact"/>
                    </Grid>
                    <TextBlock Text="Refresh" FontSize="24" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <TextBlock Text="Update the card every" VerticalAlignment="Center" Width="250" FontSize="{DynamicResource BodySize}"/>
                      <Button x:Name="ClaudeCardSecondsLess" Content="&#x2212;" Width="52" MinHeight="52" ToolTip="One second less" AutomationProperties.Name="One second less between card updates"/>
                      <TextBox x:Name="ClaudeCardSecondsBox" Width="96" MinHeight="52" Margin="8,0" TextAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Seconds between card updates"/>
                      <Button x:Name="ClaudeCardSecondsMore" Content="+" Width="52" MinHeight="52" ToolTip="One second more" AutomationProperties.Name="One second more between card updates"/>
                      <TextBlock Text="seconds" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource BodySize}"/>
                    </StackPanel>
                    <TextBlock Text="Sessions, threads, telemetry totals and logs are read again this often while the card is on a page. At least 1 second; Quiet mode doesn't change it. Your phone follows it, at most every 2 seconds." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <TextBlock Text="Check plan limits every" VerticalAlignment="Center" Width="250" FontSize="{DynamicResource BodySize}"/>
                      <Button x:Name="ClaudePlanSecondsLess" Content="&#x2212;" Width="52" MinHeight="52" ToolTip="Ten seconds less" AutomationProperties.Name="Ten seconds less between plan checks"/>
                      <TextBox x:Name="ClaudePlanSecondsBox" Width="96" MinHeight="52" Margin="8,0" TextAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Seconds between plan checks"/>
                      <Button x:Name="ClaudePlanSecondsMore" Content="+" Width="52" MinHeight="52" ToolTip="Ten seconds more" AutomationProperties.Name="Ten seconds more between plan checks"/>
                      <TextBlock Text="seconds" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource BodySize}"/>
                    </StackPanel>
                    <TextBlock x:Name="ClaudePlanSecondsNote" Text="Anthropic may slow down very frequent checks." Foreground="{DynamicResource Warning}" Style="{StaticResource Small}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock Text="At least 10 seconds. If Anthropic asks Widget Screen to slow down, it waits twice as long each time (up to 15 minutes) and the card says when the limits are from, then goes back to your interval." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,24"/>
                    <TextBlock Text="Projects" FontSize="24" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ClaudeShowNewChoice" Content="Show new projects automatically"/>
                    <TextBlock Text="Each project shows on the card as a big critter with its threads as babies; tap it to fold them in. Unticked projects leave the card, here and on your phone. The plan meters always show your whole plan." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="38,0,0,12"/>
                    <StackPanel x:Name="ClaudeProjectsList"/>
                    <TextBlock x:Name="ClaudeProjectsEmpty" Text="Projects show here once Claude Code has run on this PC." Style="{StaticResource Small}" TextWrapping="Wrap"/>
                  </StackPanel></ScrollViewer>
                  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="0,0,12,0">
                    <TextBlock Text="What Connect changes" FontSize="24" Margin="0,0,0,12"/>
                    <TextBlock Text="It adds hooks to Claude Code's settings.json, so each session tells the dashboard when it starts, works, finishes or needs you, and sets its status line." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="It also turns on Claude Code's telemetry and sends it only to Widget Screen on this PC (127.0.0.1, port 43832): token counts, cost and event names for live usage per session. Prompts, replies and tool details are never included. If settings.json already sends telemetry somewhere, that's left as it is." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Your own hooks stay as they are. If you had a status line, it keeps showing: Widget Screen runs it and passes on what it prints." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="A backup is saved next to it as settings.json.widgetscreen-backup. Disconnect takes out exactly what Connect added and puts your earlier status line back." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Sessions in the Claude app's Code tab, a terminal or an editor all show, including ones started before you connected. Usage per project is counted from Claude Code's logs and telemetry on this PC, with what it would cost at API prices (your plan doesn't pay those). Tap a session on the card to bring its window to the front." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Turn on the Claude Code widget in Edit layout." Style="{StaticResource Small}" TextWrapping="Wrap"/>
                  </StackPanel></ScrollViewer>
                </Grid>
              </TabItem>
</TabControl>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SettingsStatus" Text="" Style="{StaticResource Small}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"/><Button x:Name="CancelSettingsFooter" Grid.Column="1" Content="Cancel" MinWidth="140" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Cancel settings changes"/><Button x:Name="SaveSettings" Grid.Column="2" Content="Save changes" Style="{StaticResource AccentButton}" MinWidth="170" MinHeight="52" VerticalAlignment="Center"/></Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- The confirm sheet (ConfirmSheet): one themed "are you sure" for the whole dashboard, above Settings too. Tapping outside cancels. -->
      <Grid x:Name="ConfirmOverlay" Visibility="Collapsed" Background="#B30C0E13" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border Style="{StaticResource Card}" Width="600" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource ControlBorder}">
          <StackPanel>
            <TextBlock x:Name="ConfirmTitle" Text="QUICK LAUNCH" Style="{StaticResource Label}"/>
            <TextBlock x:Name="ConfirmSubject" Text="" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="ConfirmDetail" Text="" Style="{StaticResource Small}" TextWrapping="Wrap" MaxHeight="120" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
              <Button x:Name="ConfirmCancel" Content="Cancel" MinWidth="140" MinHeight="52" Margin="0,0,12,0" AutomationProperties.Name="Cancel"/>
              <Button x:Name="ConfirmAction" Content="Run" Style="{StaticResource AccentButton}" MinWidth="170" MinHeight="52"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Viewbox>
</Window>
